{
  "manifest_version": 3,
  "name": "Chrome Control MCP",
  "version": "0.3.1",
  "key": "",
  "description": "Lets a local MCP server control Chrome through DevTools. Gets its token from the local setup. Off until set up.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "storage", "alarms", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Control MCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
